import re
from datetime import datetime

students = []

for i in range(5):
    print(f"\n--- Student {i+1} ---")

    while True:
        enrollment = input("Enrollment No (15 characters): ")
        if len(enrollment) == 15:
            break
        print("Invalid! Enrollment No must be exactly 15 characters.")

    name = input("Name: ")

    while True:
        dob = input("DOB (DD-MM-YYYY): ")
        try:
            datetime.strptime(dob, "%d-%m-%Y")
            break
        except ValueError:
            print("Invalid! Enter DOB in DD-MM-YYYY format.")

    while True:
        mobile = input("Mobile No (10 digits): ")
        if mobile.isdigit() and len(mobile) == 10:
            break
        print("Invalid! Mobile No must be exactly 10 digits.")

    while True:
        email = input("Email Id: ")
        if re.match(r"^[\w.+-]+@[\w-]+\.[\w.-]+$", email):
            break
        print("Invalid! Enter a valid Email Id.")

    college = input("College Name: ")

    student = {
        "Enrollment No": enrollment,
        "Name": name,
        "DOB": dob,
        "Mobile No": mobile,
        "Email Id": email,
        "College Name": college
    }
    students.append(student)

print("\n\n===== Stored Student Data =====")
for i, s in enumerate(students, start=1):
    print(f"\nStudent {i}:")
    for key, value in s.items():
        print(f"{key}: {value}")
